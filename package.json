{
  "name": "heimdall",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "postcss": "^8.5.23",
    "brace-expansion": "^1.1.18",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "^5.0.9"
    },
    "@scure/base": "2.2.0",
    "js-yaml": "^4.3.1",
    "undici": "^7.29.0"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepare:standalone": "rm -rf .next/standalone/public .next/standalone/.next/static && mkdir -p .next/standalone/.next && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "npm run start:standalone",
    "start:standalone": "npm run prepare:standalone && node .next/standalone/server.js",
    "check:native-prebuild-pins": "node scripts/check-native-prebuild-pins.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:high": "npm audit --audit-level=high",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "import-graph:report": "node scripts/import-graph-report.mjs",
    "e2e": "playwright test",
    "e2e:reuse": "PLAYWRIGHT_REUSE_SERVER=true playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cosmjs-types": "0.11.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "~9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "tailwindcss": "^4.3.1",
    "typescript": "^6",
    "vitest": "^4.1.9"
  }
}
